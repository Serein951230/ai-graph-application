{
  "name": "ai-graph-application",
  "private": true,
  "version": "0.0.0",
  "description": "AI图谱应用桌面学习助手",
  "author": "AI图谱应用",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node server/index.js",
    "check:mail": "node server/check-mail-config.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "package:desktop": "npm run build && electron-builder --win --dir",
    "package:desktop:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@tsparticles/react": "^4.4.0",
    "@tsparticles/slim": "^4.4.0",
    "3d-force-graph": "^1.80.0",
    "concurrently": "^9.2.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "framer-motion": "^12.34.3",
    "jspdf": "^4.2.0",
    "nodemailer": "^10.0.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "tencentcloud-sdk-nodejs": "^4.1.315",
    "three": "^0.186.0",
    "three-spritetext": "^1.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ai.graph.application",
    "productName": "AI图谱应用",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json",
      ".env.example"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ]
    }
  }
}
