API_PORT=5174
CLIENT_ORIGIN=http://127.0.0.1:5173

# 邮箱验证码可选配置。比赛演示不需要真实注册邮件时可以留空。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-sender@example.com
# SMTP_PASS=your-smtp-password-or-app-password
# SMTP_FROM=your-sender@example.com

# 腾讯云 SES 可选配置。
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_SES_REGION=ap-hongkong
# TENCENT_SES_FROM=
# TENCENT_SES_TEMPLATE_ID=
